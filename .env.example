# --- Google Cloud ---
GCP_PROJECT_ID=neobanx-fraud-detection
GCP_REGION=us-central1

# --- Cloud SQL ---
DB_INSTANCE_NAME=neobanx-transaccional
DB_NAME=neobanx

# --- Generador de streaming ---
FECHA_INICIO="2019-02-25 22:00:00"
FECHA_FIN="2019-02-26 00:00:00"
MAX_FILAS=

# --- Monitoreo ---
# Correo que recibe las alertas (mensajes en DLQ, errores de Cloud Run,
# pendientes vencidas, presupuesto). Cada persona pone el suyo: no va fijo en el
# código porque entonces quien reproduzca el repo recibiría alertas de un
# despliegue ajeno, o peor, no recibiría ninguna. Si lo dejas vacío, las
# políticas de alerta se crean sin destinatario (el despliegue funciona igual).
ALERT_EMAIL=tu-correo@ejemplo.com

# Cuenta de facturación, para crear la alerta de presupuesto.
# Obtén el ID con:  gcloud billing accounts list
#
# OJO: los presupuestos viven en la cuenta de facturación, no en el proyecto.
# Tener Owner del proyecto NO alcanza; hace falta roles/billing.costsManager
# sobre la cuenta de facturación.
#
# Si lo dejas vacío, el presupuesto se omite y el resto funciona igual. Vale la
# pena llenarlo desde el PRIMER despliegue: Dataproc, Redis y Cloud SQL cobran
# por tiempo encendido, no por uso, así que esto es la red de seguridad contra
# un recurso olvidado.
BILLING_ACCOUNT=
BUDGET_USD=100

# ============================================================================
# SECRETOS: ya no van aquí (cambio del Sprint 2)
# ============================================================================
#
# Este archivo ya NO pide DB_PASSWORD ni GENERATOR_SALT.
#
# Terraform genera la contraseña de postgres, las de los cinco roles de
# aplicación y la clave HMAC, y las guarda en Secret Manager. Los servicios las
# leen de ahí en tiempo de ejecución.
#
# Esto resuelve dos cosas:
#   - Reproducibilidad: clonar el repo y desplegar ya no exige pedirle secretos
#     a nadie por un canal privado. Antes ese paso manual era el mayor hueco de
#     reproducibilidad del proyecto.
#   - Un fallo silencioso: si dos personas desplegaban con un GENERATOR_SALT
#     distinto, los cc_num_hash no coincidían y el join entre cuentas y
#     transacciones quedaba roto sin dar ningún error.
#
# Para consultar un secreto cuando haga falta:
#   gcloud secrets versions access latest --secret=neobanx-db-postgres
#
# La clave HMAC tampoco va aquí, y es a propósito: una variable por persona que
# alimenta un secreto compartido volvería a abrir el mismo fallo silencioso
# (dos personas aplicando con valores distintos invalidan los cc_num_hash ya
# almacenados, sin dar error). Ver Infrastructure/secrets.tf, sección
# "Alternativa descartada".
